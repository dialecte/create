				"strip": "xmlschema-4.3.2/",
				"keep": ["tests/test_cases/", "LICENSE"]
			},
			"exclude": [
				"tests/test_cases/examples/stockquote/*",
				"tests/test_cases/features/wsdl/*",
				"tests/test_cases/issues/issue_237/*.wsdl"
			]
		},
