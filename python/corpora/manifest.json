{
	"$comment": "Corpora admitted by the licence review (plan 10b, licence table): fetched by `python -m corpora.fetch`, cached, never committed. A source needs license, terms and verdict; sha256 values are pinned by --pin and reviewed. verdict full = mutated copies allowed; schemas-only = never mutated.",
	"sources": [
		{
			"id": "libxml2-tests",
			"family": "suite",
			"suite": "libxml2",
			"license": "MIT",
			"terms": "https://gitlab.gnome.org/GNOME/libxml2/-/raw/v2.15.4/Copyright",
			"verdict": "full",
			"note": "xml.xsd (W3C) replaced by our own; nvdcve_0.* (NIST feed, no licence stated), vdv-* (book examples, origin unstated) left out; po0/po1 and all.xsd (from the W3C XML Schema Primer) left out",
			"fetch": {
				"kind": "archive",
				"url": "https://gitlab.gnome.org/GNOME/libxml2/-/archive/v2.15.4/libxml2-v2.15.4.tar.gz",
				"sha256": "a569ee9c59eabb197a0d5047046d757ee14c86fb2d4a734555b633cb5584ad25",
				"strip": "libxml2-v2.15.4/",
				"keep": ["test/schemas/", "result/schemas/", "Copyright"]
			},
			"exclude": [
				"test/schemas/xml.xsd",
				"test/schemas/nvdcve_0.*",
				"test/schemas/vdv-*",
				"result/schemas/nvdcve_0*",
				"result/schemas/vdv-*",
				"test/schemas/po[0-9]_*",
				"result/schemas/po[0-9]_*",
				"test/schemas/all.xsd"
			],
			"substitute": {
				"test/schemas/xml.xsd": "xml.xsd"
			}
		},
		{
			"id": "xmlschema-tests",
