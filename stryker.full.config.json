{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "command",
	"commandRunner": {
		"command": "node scripts/test-runner/run-tests.ts full"
	},
	"mutate": ["src/derive/**/*.ts", "!src/derive/**/*.test.ts", "!src/derive/**/*.types.ts"],
	"coverageAnalysis": "off",
	"reporters": ["progress", "json"],
	"jsonReporter": {
		"fileName": ".tmp/stryker/report-full.json"
	},
	"tempDirName": ".tmp/stryker-full-tmp",
	"cleanTempDir": "always",
	"concurrency": 6,
	"timeoutMS": 60000,
	"disableTypeChecks": false
}
