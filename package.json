{
	"name": "@dialecte/create",
	"version": "0.2.1",
	"description": "Scaffold and generate Dialecte SDKs from an XSD schema. Runs the Python generator in WebAssembly - no Python required.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dialecte/create.git"
	},
	"bin": {
		"create-dialecte": "./dist/cli/index.js"
	},
	"files": [
		"dist",
		"skills",
		"!skills/*/evals",
		"templates",
		"vendor",
		"python/generate",
		"python/pyproject.toml",
		"README.md"
	],
	"type": "module",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"start": "node dist/cli/index.js",
		"vendor": "node scripts/vendor-wheels.mjs",
		"type-check": "tsc --noEmit",
		"lint:check": "oxlint",
		"lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"check": "npm run type-check && npm run lint:check && npm run format:check",
		"skills:generate": "dialecte skills generate",
		"skills:check": "dialecte skills check",
		"test:ts": "node scripts/test-runner/run-tests.ts all",
		"test:hook": "dialecte gate --hook",
		"derive:check": "node scripts/derive-check/derive-check.ts",
		"definition:diff": "node scripts/definition-diff/definition-diff.ts",
		"test:py": "cd python && $(test -x .venv/bin/python && echo .venv/bin/python || echo python3) -m pytest",
		"test:cli": "npm run build && node scripts/smoke.mjs",
		"test:cli:install": "SMOKE_INSTALL=1 npm run test:cli",
		"proof": "node scripts/proof.mjs",
		"mutants": "cd python && $(test -x .venv/bin/python && echo .venv/bin/python || echo python3) -m mutants.run",
		"mutants:ts": "node scripts/mutants-ts/mutants-ts.ts",
		"corpora:fetch": "cd python && $(test -x .venv/bin/python && echo .venv/bin/python || echo python3) -m corpora.fetch",
		"test:corpora": "cd python && PROOF_CORPORA=1 $(test -x .venv/bin/python && echo .venv/bin/python || echo python3) -m pytest tests/corpora -q -n 6 --dist loadgroup",
		"fuzz": "cd python && $(test -x .venv/bin/python && echo .venv/bin/python || echo python3) -m proof.fuzz",
		"prepack": "find python -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true",
		"prepare": "husky",
		"prepublishOnly": "npm run vendor && npm run build"
	},
	"dependencies": {
		"oxfmt": "^0.75.0",
		"pyodide": "^0.27.2"
	},
	"devDependencies": {
		"@dialecte/cli": "0.3.0",
		"@stryker-mutator/core": "10.0.0",
		"@types/node": "^22.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"husky": "^9.1.7",
		"oxlint": "^1.68.0",
		"tsup": "^8.5.1",
		"typescript": "^5.6.0"
	},
	"engines": {
		"node": ">=20"
	},
	"dialecte": {
		"profile": "contributor",
		"gate": {
			"fast": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "tests-ts",
					"run": "npm run test:ts",
					"counts": "tests"
				}
			],
			"full": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "build",
					"run": "npm run build"
				},
				{
					"name": "tests-ts",
					"run": "npm run test:ts",
					"counts": "tests"
				},
				{
					"name": "tests-py",
					"run": "npm run test:py"
				}
			]
		}
	}
}
