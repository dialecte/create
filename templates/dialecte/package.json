{
	"name": "__packageName__",
	"version": "0.0.1",
	"description": "Dialecte SDK for __dialecteId__",
	"license": "MIT",
	"source": "src/index.ts",
	"files": [
		"dist",
		"skills",
		"!skills/*/evals"
	],
	"type": "module",
	"exports": {
		"./__version__": {
			"types": "./dist/__version__/index.d.ts",
			"default": "./dist/__version__/index.js"
		},
		"./__version__/test": {
			"types": "./dist/__version__/test.d.ts",
			"default": "./dist/__version__/test.js"
		}
	},
	"scripts": {
		"//====== BUILD ======//": "",
		"build": "run-p type-check \"build-only {@}\" --",
		"build-only": "tsc -p tsconfig.json && vite build",
		"//====== VITEPRESS ======//": "",
		"doc:dev": "vitepress dev docs",
		"doc:build": "vitepress build docs",
		"doc:preview": "vitepress preview docs",
		"//====== DEFINITION ======//": "",
		"generate": "npm create @dialecte generate -- --out-dir ./src/__version__/definition__generateOptions__ --entry",
		"//====== TEST ======//": "",
		"pretest": "playwright install chromium",
		"test": "npm run test:node && npm run test:browser",
		"test:node": "vitest run --project node",
		"test:browser": "vitest run --project browser --passWithNoTests",
		"test:browser:all": "vitest run --project browser-all",
		"test:hook": "dialecte gate --hook",
		"//====== CHECK ======//": "",
		"check": "run-p type-check type-check:test type-check:node lint:check format:check",
		"skills:generate": "dialecte skills generate",
		"skills:check": "dialecte skills check",
		"type-check": "tsc -p tsconfig.build.json --noEmit",
		"type-check:test": "tsc -p tsconfig.vitest.json --noEmit",
		"type-check:node": "tsc -p tsconfig.node.json --noEmit",
		"lint:check": "oxlint",
		"lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"//====== TYPE PERF ======//": "",
		"coverage:gen": "dialecte coverage",
		"type-bench": "npm run coverage:gen && dialecte bench",
		"type-bench:check": "npm run coverage:gen && dialecte bench --check",
		"type-narrowing": "npm run coverage:gen && dialecte narrowing",
		"type-audit": "dialecte audit",
		"//====== HOOKS ======//": "",
		"prepare": "husky && node scripts/prepare.mjs"
	},
	"dependencies": {
		"@dialecte/core": "__coreVersion__"
	},
	"devDependencies": {
		"@dialecte/cli": "0.3.1",
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.12.4",
		"@vitest/browser-playwright": "^4.1.10",
		"husky": "^9.1.7",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"playwright": "1.62.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-dts": "^5.0.2",
		"vitepress": "^2.0.0-alpha.17",
		"vitest": "^4.1.10"
	},
	"dialecte": {
		"profile": "contributor",
		"gate": {
			"fast": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "tests",
					"run": "npx vitest run --project node --changed",
					"counts": "tests",
					"changedOnly": true
				}
			],
			"full": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "build",
					"run": "npm run build"
				},
				{
					"name": "tests",
					"run": "npx vitest run --project node",
					"counts": "tests"
				},
				{
					"name": "browser tests",
					"run": "npx vitest run --project browser --passWithNoTests"
				}
			]
		},
		"tdd": {
			"production": [
				"src/__version__/test"
			]
		}
	}
}
