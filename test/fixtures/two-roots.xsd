<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<!-- an abstract head and its members: a member may appear wherever the head is named -->
	<xs:element name="instruction" abstract="true" />
	<xs:element name="for-each" substitutionGroup="instruction" />
	<xs:element name="choose" substitutionGroup="instruction" />
	<!-- two elements that can start a document: the scaffold must be told which -->
	<xs:element name="score-partwise">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="instruction" minOccurs="0" maxOccurs="unbounded" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="score-timewise">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="instruction" minOccurs="0" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
