<?xml version="1.0" encoding="UTF-8"?>
<!-- A document the torture schema redefines: its tLegacy is extended by the redefinition. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:dialecte:torture"
	targetNamespace="urn:dialecte:torture" elementFormDefault="qualified">
	<xs:complexType name="tLegacy">
		<xs:sequence>
			<xs:element name="Old" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
